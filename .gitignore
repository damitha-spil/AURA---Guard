node_modules/
engine/dist/
# The index is rebuilt from the vault and the repos; never commit it.
data/
*.db
*.db-wal
*.db-shm
# Local settings may hold paths to private repos.
guard.config.local.json
.artifacts/
# Masking audit log stays on this machine.
logs/

# Local Python env for graphify (never commit).
.venv/
# Obsidian keeps per-machine window layout and caches here.
vault/.obsidian/workspace*.json
vault/.obsidian/cache

# Built at test time from evals/masking/generate.mjs (fake secrets; never commit).
evals/masking/cases.jsonl
# Chat window browser profile and saved chats (also covered by data/).
data/ui-profile/
data/chats/

# Knowledge derived from private repos and chats stays on this machine.
# Only the vault's README, templates and Obsidian settings are shared.
vault/*
!vault/README.md
!vault/_templates/
!vault/.obsidian/
!vault/support/
vault/support/*
!vault/support/forbidden-terms.json
evals/quiz/questions.json
qa/generated/*
!qa/generated/.gitkeep

extension/node_modules/
extension/dist/
*.vsix

# Rust / Tauri build artifacts
src-tauri/target/

# React + Vite + shadcn frontend build & deps
web/node_modules/
web/dist/
web/tsconfig.tsbuildinfo
