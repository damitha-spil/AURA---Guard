{
  "description": "Record every git commit in the repo's AI activity log (ai-log/).",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/log-commit.mjs"],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
