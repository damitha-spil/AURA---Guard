{
  "$comment": "Steps of `aura-guard daily`, in order. Product default: a company can edit this file. needsModel steps are skipped with --no-model. role: the department helper that must be on (departments only). needsRepo: skipped when the department has no git source. optional steps are skipped quietly when the command does not exist or its service is unreachable.",
  "steps": [
    { "id": "index", "argv": ["index"], "timeoutMin": 20 },
    { "id": "check", "argv": ["check"], "timeoutMin": 2 },
    { "id": "prs-sync", "argv": ["prs", "sync"], "timeoutMin": 10, "optional": true, "role": "prs", "needsRepo": true },
    { "id": "mine-sessions", "argv": ["mine", "--min-score", "0.7", "--max", "15"], "timeoutMin": 5, "role": "scribe", "needsRepo": true },
    { "id": "mine-prs", "argv": ["prs", "mine", "--min-score", "0.7", "--max", "15"], "timeoutMin": 5, "optional": true, "role": "prs", "needsRepo": true },
    { "id": "rules-propose", "argv": ["rules", "propose"], "timeoutMin": 5, "optional": true, "role": "rules" },
    { "id": "logcheck", "argv": ["logcheck"], "timeoutMin": 5, "optional": true, "needsRepo": true },
    { "id": "stale", "argv": ["stale"], "timeoutMin": 2 },
    { "id": "diary", "argv": ["diary"], "timeoutMin": 10, "needsModel": true, "role": "scribe" }
  ]
}
