{
  "name": "aura-guard",
  "version": "0.1.0",
  "private": true,
  "description": "SPIL's internal engineering assistant that learns Aura",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "aura-guard": "bin/aura-guard.mjs"
  },
  "scripts": {
    "build": "tsc -p engine",
    "typecheck": "tsc -p engine --noEmit && tsc -p engine/tsconfig.test.json",
    "test": "node bin/run-tests.mjs",
    "guard": "node bin/aura-guard.mjs",
    "mcp": "node --experimental-strip-types engine/src/mcp/server.ts",
    "ui": "node bin/aura-guard.mjs ui"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
